{
  "name": "solar-odyssey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "太阳系奥德赛 —— 真实太阳系驾驶模拟",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:textures": "node tools/fetch_textures.mjs",
    "verify:horizons": "vitest run --config vitest.verify.config.ts",
    "verify:truth": "vitest run --config vitest.verify.config.ts verify/truth.verify.test.ts",
    "fetch:ephemeris": "node tools/fetch_ephemeris.mjs",
    "verify:satellites": "vitest run --config vitest.verify.config.ts verify/satellites.verify.test.ts",
    "fetch:satellites": "node tools/fetch_satellites.mjs",
    "fetch:stars": "node tools/fetch_stars.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
